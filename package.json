{
  "name": "quick-notes",
  "version": "0.5.4",
  "description": "A simple example of virtual post-it notes using SvelteKit",
  "author": "Michael Daniel Padilla <michaeldpadilla@gmail.com> (https://mikedpad.com)",
  "license": "MIT",
  "homepage": "https://mikedpad.github.io/quick-notes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikedpad/quick-notes.git"
  },
  "type": "module",
  "scripts": {
    "start": "vite dev --host",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "generateData": "node --experimental-strip-types src/dev/generateData.ts",
    "generateTexture": "node --experimental-strip-types src/dev/generateTexture.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "post-it",
    "notes",
    "svelte",
    "sveltekit"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@lucide/svelte": "^1.27.0",
    "@skeletonlabs/skeleton": "^5.0.0",
    "@skeletonlabs/skeleton-svelte": "^5.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^18.0.7"
  }
}
